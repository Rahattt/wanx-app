diff --git a/option/tcp_fragment_wanx.go b/option/tcp_fragment_wanx.go
new file mode 100644
index 0000000..b366dac
--- /dev/null
+++ b/option/tcp_fragment_wanx.go
@@ -0,0 +1,18 @@
+package option
+
+// TCPFragmentOptions splits the first writes of a TCP connection the way
+// Xray's freedom "fragment" does (added by WanX). Ranges are "min-max" or a
+// single number.
+type TCPFragmentOptions struct {
+	// "tlshello": split the TLS ClientHello into several TLS records, one
+	// per write. "N-M": split writes N to M (counted from 1) into raw TCP
+	// writes. Empty: every write.
+	Packets string `json:"packets,omitempty"`
+	// Size of each piece, in bytes.
+	Length string `json:"length"`
+	// Pause after each piece, in milliseconds. With "tlshello" and no
+	// interval the records go out in one write (record splitting only).
+	Interval string `json:"interval,omitempty"`
+	// Maximum number of pieces per write; the last one takes the rest.
+	MaxSplit string `json:"max_split,omitempty"`
+}
